{
  "name": "frontend-lab",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "scripts/validate",
    "guard": "scripts/guard",
    "test:packages": "playwright test --project=packages",
    "test:scripts": "playwright test --project=scripts",
    "test:a11y": "playwright test --project=a11y",
    "test:visual": "playwright test --project=visual",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm validate && pnpm guard && pnpm test:packages && pnpm test:scripts && pnpm test:a11y"
  },
  "prettier": {
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "printWidth": 90,
    "tabWidth": 2
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "yaml": "2.9.1"
  }
}
